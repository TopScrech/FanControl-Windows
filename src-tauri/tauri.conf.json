{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FanControl",
  "version": "0.1.0",
  "identifier": "dev.topscrech.fancontrol-windows",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FanControl",
        "label": "main",
        "width": 900,
        "height": 720,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
